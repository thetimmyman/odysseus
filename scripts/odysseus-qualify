#!/usr/bin/env python3
"""Measure an existing approximate 4K profile; never import or activate it.

The operator supplies a trusted identity-collector argv in a JSON file. It must
emit a fresh checked_at/current_material_identity observation on stdout and
exit nonzero if endpoint, artifact, runtime or host binding cannot be verified.
Obtain the runtime's normal capacity lease before running this command.
"""
import argparse
import json
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from src.constants import (LOCAL_QUALIFICATION_AFTER_FILENAME,
                           LOCAL_QUALIFICATION_BEFORE_FILENAME,
                           LOCAL_QUALIFICATION_FAILURE_FILENAME,
                           LOCAL_QUALIFICATION_RECEIPT_FILENAME)
from src.local_targets import (LocalTargetSpec, make_target_capability_receipt,
                              target_capability_receipt_hash_is_valid)
from src.local_target_qualification import qualify_existing_profile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--receipt', required=True, type=Path)
    parser.add_argument('--spec', required=True, type=Path)
    parser.add_argument('--identity-command', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    args = parser.parse_args()
    created = False
    try:
        raw = json.loads(args.receipt.read_text())
        if not target_capability_receipt_hash_is_valid(raw):
            raise ValueError('receipt hash does not cover existing evidence')
        receipt = make_target_capability_receipt(**raw)
        spec = LocalTargetSpec(**json.loads(args.spec.read_text()))
        command = json.loads(args.identity_command.read_text())
        if (not isinstance(command, list) or not command or
                any(not isinstance(value, str) or not value for value in command)):
            raise ValueError('identity command must be a nonempty JSON argv list')
        # Never overwrite a previous attempt, including a failed measurement.
        args.output_dir.mkdir(mode=0o700, parents=True, exist_ok=False)
        created = True

        def capture(filename):
            result = subprocess.run(command, capture_output=True, text=True,
                                    timeout=1800, check=True)
            observation = json.loads(result.stdout)
            (args.output_dir / filename).write_text(
                json.dumps(observation, sort_keys=True, indent=2) + '\n')
            return observation

        before = capture(LOCAL_QUALIFICATION_BEFORE_FILENAME)
        candidate, report = qualify_existing_profile(
            spec, receipt, before,
            lambda: capture(LOCAL_QUALIFICATION_AFTER_FILENAME), args.output_dir)
        (args.output_dir / LOCAL_QUALIFICATION_RECEIPT_FILENAME).write_text(
            json.dumps(candidate.to_dict(), sort_keys=True, indent=2) + '\n')
        print(json.dumps({'profile_id': candidate.profile_id,
                          'receipt_hash': candidate.receipt_hash,
                          'safe_context': candidate.context.safe_working_context,
                          'trials': report['trials'],
                          'applied': False}, sort_keys=True))
        return 0
    except Exception as exc:
        if created:
            with (args.output_dir / LOCAL_QUALIFICATION_FAILURE_FILENAME).open('x') as handle:
                json.dump({'failure_class': type(exc).__name__, 'detail': str(exc),
                           'collector_stderr': str(getattr(exc, 'stderr', '') or '')}, handle)
        # Collector/provider errors can contain private endpoint or credential
        # material. Keep those in operator-owned evidence, never echo them.
        print('qualification refused: ' + type(exc).__name__ +
              '; no receipt applied', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
